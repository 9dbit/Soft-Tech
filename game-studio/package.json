{
  "name": "soft-tech-universal-game-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/slot-core.test.mjs tests/slot-pilot-contract.test.mjs tests/slot-audit.test.mjs tests/slot-manifest-gates.test.mjs tests/slot-release-gate.test.mjs tests/slot-audit-matrix.test.mjs tests/factory-import.test.mjs tests/raster-assets.test.mjs tests/legend-link.test.mjs",
    "audit:smoke": "node scripts/run-slot-audit.mjs --rounds 1000 --seed-domain softtech-slot-pilot-ci-A --output test-results/slot-audit-smoke.json",
    "audit:matrix": "node scripts/run-slot-audit-matrix.mjs --rounds-per-domain 1000 --output test-results/slot-matrix-smoke.json"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "lucide-react": "^0.468.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0"
  }
}
